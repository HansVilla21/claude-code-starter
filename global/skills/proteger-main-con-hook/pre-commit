#!/bin/sh
# -----------------------------------------------------------------------------
# pre-commit: bloquea los commits directos en main y master.
#
# Por qué existe: en un proyecto real, un commit directo a main se publicó a
# producción sin pasar por revisión, aunque la regla «nunca commit directo a
# main» estaba escrita hacía semanas. Una regla escrita depende de que alguien
# se acuerde. Este archivo no.
#
# Defensa en profundidad:
#   1. CLAUDE.md   -> explica la regla
#   2. este hook   -> la hace cumplir siempre   <- acá estás
#   3. .gitignore  -> última línea de defensa
#
# Lo que deja pasar, a propósito:
#   - Un merge en curso (existe MERGE_HEAD): mergear no es commitear directo.
#   - Una emergencia real (por ejemplo, revertir algo que ya está en producción):
#         ALLOW_MAIN_COMMIT=1 git commit -m "..."
#     Es explícito: queda claro que fue una decisión, no un descuido.
#
# Instalación, una vez por clon (.git/hooks/ no se versiona; sin esto el hook
# está en el repo pero no corre):
#     git config core.hooksPath .githooks
# Verificar:  git config core.hooksPath   -> tiene que decir .githooks
#
# Más detalle: skill proteger-main-con-hook.
# -----------------------------------------------------------------------------

branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)

# Un merge en curso no es un commit directo: dejarlo pasar.
if [ -f "$(git rev-parse --git-dir)/MERGE_HEAD" ]; then
  exit 0
fi

case "$branch" in
  main|master)
    if [ "$ALLOW_MAIN_COMMIT" = "1" ]; then
      echo "AVISO: commit en '$branch' permitido por ALLOW_MAIN_COMMIT=1 (escape explícito)."
      exit 0
    fi
    echo ""
    echo "  BLOQUEADO: estás haciendo commit directo en '$branch'."
    echo ""
    echo "  En este proyecto cada cambio va en su rama y llega a '$branch' por pull request."
    echo "  Un commit acá se saltea la revisión y, si el proyecto publica desde '$branch',"
    echo "  llega a producción sin validar."
    echo ""
    echo "  Qué hacer:"
    echo "    git switch -c feat/<nombre>     # o fix/, docs/, refactor/ (tus cambios pasan a la rama)"
    echo "    git commit ...                  # y de ahí, pull request"
    echo ""
    echo "  Si ya tenías commits en '$branch' sin subir y querés pasarlos a una rama:"
    echo "    git switch -c feat/<nombre>           # la rama nueva se lleva los commits"
    echo "    git branch -f $branch origin/$branch  # y '$branch' vuelve a quedar como el remoto"
    echo ""
    echo "  Emergencia real (por ejemplo, revertir algo que ya está en producción):"
    echo "    ALLOW_MAIN_COMMIT=1 git commit ..."
    echo ""
    exit 1
    ;;
esac

exit 0
